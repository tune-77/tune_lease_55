<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.tunelease.next</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/kobayashiisaoryou/clawd/tune_lease_55/run_next_stable.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/kobayashiisaoryou/clawd/tune_lease_55</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>FORCE_RESTART</key>
    <string>1</string>
    <key>PUBLIC_TUNNEL</key>
    <string>1</string>
    <!-- 固定URL https://shion.tune77.com。CLOUDFLARE_TUNNEL_CONFIG（ホーム配下の設定ファイル）は
         scripts/install_next_launchagent.sh が存在確認して注入する。無ければ quick tunnel にフォールバック。 -->
    <key>CLOUDFLARE_TUNNEL_HOSTNAME</key>
    <string>shion.tune77.com</string>
    <key>API_HOST</key>
    <string>127.0.0.1</string>
    <key>NEXT_HOST</key>
    <string>127.0.0.1</string>
    <key>API_RELOAD</key>
    <string>0</string>
    <key>SHION_ENABLE_VERTEX_TOOLS</key>
    <string>1</string>
    <key>SHION_VOICE_ENABLED</key>
    <string>1</string>
    <key>SHION_SING_ENABLED</key>
    <string>1</string>
    <key>SHION_TTS_ENABLED</key>
    <string>1</string>
    <key>TYPESAFE_RAG_ENABLED</key>
    <string>1</string>
    <key>TYPESAFE_ROUTING_MODE</key>
    <string>enforce</string>
    <key>TYPESAFE_ROUTING_CONFIDENCE</key>
    <string>0.85</string>
    <key>TYPESAFE_RECIPE_CLASSIFY_ENABLED</key>
    <string>1</string>
    <key>TYPESAFE_API_KEYCHAIN_SERVICE</key>
    <string>typesafe-api-key</string>
    <key>TYPESAFE_RAG_USAGE_LOG_PATH</key>
    <string>data/typesafe_rag_usage.jsonl</string>
    <!-- 検索でハブが当たった時に、Jev 判定済みの最近のニュース永続メモを参考として2件まで添える
         （REV-502 で追加・REV-532 でオン。止める時は 0 にして再起動） -->
    <key>SHION_NEWS_ZETTEL_CONTEXT</key>
    <string>1</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <!-- 画面からの要求に答える常駐なので Interactive。Background だと CPU・I/O が絞られ、
       チャット1件が10分近くかかって Cloudflare のタイムアウト（約100秒）でエラーになった（2026-10-04）。 -->
  <key>ProcessType</key>
  <string>Interactive</string>

  <key>ThrottleInterval</key>
  <integer>10</integer>

  <key>StandardOutPath</key>
  <string>/Users/kobayashiisaoryou/clawd/tune_lease_55/logs/next/launchd.out.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/kobayashiisaoryou/clawd/tune_lease_55/logs/next/launchd.err.log</string>
</dict>
</plist>
