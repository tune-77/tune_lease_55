# Local development only. Never commit real values.
GEMINI_API_KEY=
OPENAI_API_KEY=
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_WEBHOOK_URL=

# Runtime configuration
PORT=8080
FASTAPI_PORT=8000
DATA_DIR=./data
ENABLE_OBSIDIAN_INDEXING=false
ENABLE_FEEDBACK_LOADING=false
ENABLE_GUNSHI_RAG=false

# TypeSafe/Jev RAG context reduction (see docs/typesafe_rag_pilot.md). Off by default.
TYPESAFE_RAG_ENABLED=0
TYPESAFE_API_KEY=
# macOS alternative to TYPESAFE_API_KEY: read the key from Keychain instead.
TYPESAFE_API_KEYCHAIN_SERVICE=
# Optional: append candidate/accepted/excluded counts here for effectiveness
# reporting (scripts/typesafe_rag_usage_report.py). Empty = no logging.
TYPESAFE_RAG_USAGE_LOG_PATH=
# Question-category routing shadow test: off | shadow | enforce. shadow only
# compares Jev's category against the existing classifier and logs it; it
# never changes which category is used.
TYPESAFE_ROUTING_MODE=off
# Required in addition to TYPESAFE_RAG_ENABLED for any Jev call that reads
# shared Obsidian vault content (curator, staleness shadow tests below).
TYPESAFE_ALLOW_SHARED_CONTEXT=0
# Obsidian curator connect_used_isolate relatedness shadow test: off | shadow.
# shadow only logs Jev's judgment to data/obsidian_curation_shadow_log.jsonl;
# it never adds links to the Vault (see scripts/typesafe_curation_shadow_report.py).
TYPESAFE_CURATION_MODE=off
# ChromaDB reduction-candidate relevance shadow test: off | shadow. shadow only
# logs Jev's judgment to data/rag_staleness_shadow_log.jsonl next to the
# existing keyword heuristic; it never changes stale/important_but_unused
# classification or the improvement ledger.
TYPESAFE_STALENESS_MODE=off
