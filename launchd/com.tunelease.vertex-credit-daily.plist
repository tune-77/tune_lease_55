<dict>
  <key>Label</key>
  <string>com.tunelease.vertex-credit-daily</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/kobayashiisaoryou/clawd/tune_lease_55/scripts/run_vertex_credit_daily.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/kobayashiisaoryou/clawd/tune_lease_55</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PYTHONPATH</key>
    <string>/Users/kobayashiisaoryou/clawd/tune_lease_55</string>
    <key>PYTHON</key>
    <string>/Users/kobayashiisaoryou/clawd/tune_lease_55/.venv/bin/python</string>
