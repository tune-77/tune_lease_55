<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.tunelease.lease-news-collector</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>/Users/kobayashiisaoryou/clawd/tune_lease_55/scripts/run_lease_news_collection.sh</string>
    <string>--limit</string>
    <string>18</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PYTHONPATH</key>
    <string>/Users/kobayashiisaoryou/clawd/tune_lease_55</string>
    <key>OBSIDIAN_VAULT_PATH</key>
    <string>/Users/kobayashiisaoryou/Library/Mobile Documents/iCloud~md~obsidian/Documents/Obsidian Vault</string>
    <key>OBSIDIAN_VAULT</key>
    <string>/Users/kobayashiisaoryou/Library/Mobile Documents/iCloud~md~obsidian/Documents/Obsidian Vault</string>
    <key>LEASE_NEWS_PROFILE</key>
    <string>industry-watch</string>
    <!-- REV-411/412: Jevガードを shadow で計測（送信内容は変えない）。
         enforce へ上げる前に [news-guard] の1行JSONを1〜2週間集計する。 -->
    <key>TYPESAFE_NEWS_MODE</key>
    <string>shadow</string>
    <!-- launchd は .zshrc を読まないため Keychain のサービス名をここで渡す
         （鍵そのものはplistに置かない）。 -->
    <key>TYPESAFE_API_KEYCHAIN_SERVICE</key>
    <string>typesafe-api-key</string>
    <key>PYTHON_BIN</key>
    <string>/Users/kobayashiisaoryou/clawd/tune_lease_55/.venv/bin/python</string>
    <key>PATH</key>
    <string>/Users/kobayashiisaoryou/clawd/tune_lease_55/.venv/bin:/Users/kobayashiisaoryou/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/Users/kobayashiisaoryou/anaconda3/bin</string>
    <key>PYTHONUNBUFFERED</key>
    <string>1</string>
  </dict>

  <!-- secret_manager の st.secrets 参照は cwd 依存で、リポジトリ外から起動すると
       StreamlitSecretNotFoundError になり GEMINI_API_KEY が空に落ちる。その結果
       AI分類が無言でスキップされていた（autoresearch 側のplistには元からある）。 -->
  <key>WorkingDirectory</key>
  <string>/Users/kobayashiisaoryou/clawd/tune_lease_55</string>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>6</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/kobayashiisaoryou/Library/Logs/tune_lease_55_lease_news.out.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/kobayashiisaoryou/Library/Logs/tune_lease_55_lease_news.err.log</string>
</dict>
</plist>
